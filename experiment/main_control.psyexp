        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import random&amp;#10;# standard_tone&amp;#10;standard_tone = r&quot;E:\ecf-exp2-notif-mmn\experiment\audio\iphone_sound.wav&quot;&amp;#10;#deviant_tone  &amp;#10;deviant_tone = r&quot;E:\ecf-exp2-notif-mmn\experiment\audio\\bing.wav&quot;&amp;#10;#control_tone&amp;#10;control_tone = r&quot;E:\ecf-exp2-notif-mmn\experiment\audio\control_tone.wav&quot;&amp;#10;def gen_rnd(start, end,total_trail):&amp;#10;    while(1):&amp;#10;        random_numbers = np.random.randint(start, end, 150)&amp;#10;        #print(random_numbers)&amp;#10;        random_numbers = np.cumsum(random_numbers)&amp;#10;        if random_numbers[-1]&gt;total_trail or random_numbers[-1]&lt;total_trail - start:&amp;#10;            continue&amp;#10;        else:&amp;#10;            return random_numbers&amp;#10;def MMN_stimuli(num_trials,deviant_tone,standard_tone,deviant_freq= (3,9)):&amp;#10;    tone =[]&amp;#10;    deviant_trail = gen_rnd(deviant_freq[0],deviant_freq[1],num_trials)&amp;#10;    for n in range(1,num_trials+1):&amp;#10;        if n in deviant_trail:&amp;#10;                tone.append(deviant_tone) &amp;#10;        else:&amp;#10;            tone.append(standard_tone)&amp;#10;    return tone&amp;#10;&amp;#10;tones = MMN_stimuli(900,deviant_tone,standard_tone)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="var _pj;&amp;#10;function _pj_snippets(container) {&amp;#10;    function in_es6(left, right) {&amp;#10;        if (((right instanceof Array) || ((typeof right) === &quot;string&quot;))) {&amp;#10;            return (right.indexOf(left) &gt; (- 1));&amp;#10;        } else {&amp;#10;            if (((right instanceof Map) || (right instanceof Set) || (right instanceof WeakMap) || (right instanceof WeakSet))) {&amp;#10;                return right.has(left);&amp;#10;            } else {&amp;#10;                return (left in right);&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;    container[&quot;in_es6&quot;] = in_es6;&amp;#10;    return container;&amp;#10;}&amp;#10;_pj = {};&amp;#10;_pj_snippets(_pj);&amp;#10;standard_tone = new sound.Sound(&quot;Experiment1.2\\code\\iphone_sound.mp3&quot;);&amp;#10;deviant_tone = new sound.Sound(&quot;Experiment1.2\\code\\bing-[AudioTrimmer.com].mp3&quot;);&amp;#10;function gen_rnd(start, end, total_trail) {&amp;#10;    var random_numbers;&amp;#10;    while (1) {&amp;#10;        random_numbers = np.random.randint(start, end, 150);&amp;#10;        random_numbers = np.cumsum(random_numbers);&amp;#10;        if (((random_numbers.slice((- 1))[0] &gt; total_trail) || (random_numbers.slice((- 1))[0] &lt; (total_trail - start)))) {&amp;#10;            continue;&amp;#10;        } else {&amp;#10;            return random_numbers;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;function MMN_stimuli(num_trials, isi, deviant_freq = [3, 9]) {&amp;#10;    var deviant_trail;&amp;#10;    deviant_trail = gen_rnd(deviant_freq[0], deviant_freq[1], num_trials);&amp;#10;    for (var n, _pj_c = 0, _pj_a = util.range(1, (num_trials + 1)), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        n = _pj_a[_pj_c];&amp;#10;        if (_pj.in_es6(n, deviant_trail)) {&amp;#10;            deviant_tone.play();&amp;#10;            port.write(str.encode(&quot;255&quot;));&amp;#10;            outlet.push_sample(markers[&quot;personalized_tone&quot;]);&amp;#10;            core.wait((isi + (Math.random.randint(0, 10) * 0.01)));&amp;#10;        } else {&amp;#10;            standard_tone.play();&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
